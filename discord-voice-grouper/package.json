{
  "name": "discord-voice-grouper",
  "version": "1.0.0",
  "description": "Discord voice channel members grouper for groups of three or four.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "register": "node --env-file-if-exists=.env src/register-commands.js",
    "start": "node --env-file-if-exists=.env src/bot.js",
    "dev": "node --env-file-if-exists=.env --watch src/bot.js"
  },
  "dependencies": {
    "discord.js": "^14.22.1"
  }
}

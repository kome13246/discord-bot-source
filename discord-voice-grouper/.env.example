DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here

# Optional: DISBOARD bot ID. The default is the public DISBOARD bot ID.
# DISBOARD_BOT_ID=302050872383242240

# Optional: set this while testing so slash command updates appear immediately.
# DISCORD_GUILD_ID=123456789012345678

# Optional: enable a small HTTP health endpoint for hosting or keep-alive checks.
# Many hosting services set PORT automatically, so this is mainly for local testing.
# KEEP_ALIVE_PORT=3000

# Optional: persistent PB settings for hosted environments.
# These are used when /setting has not saved settings for the server.
# PB_PARTICIPANT_ROLE_ID=123456789012345678
# PB_PARENT_CHANNEL_ID=123456789012345678
# PB_CHILD_CATEGORY_ID=123456789012345678
# PB_FINISH_MESSAGE=終了時間です。
# PB_TRANSFER_WAIT_SECONDS=30
# PB_NOTICE_WAIT_MINUTES=25
# PB_ROLE_REMOVE_WAIT_MINUTES=3

# Required: Discord Developer Portalで取得します。
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here
MONGODB_URI=your_mongodb_atlas_connection_string_here
DISCORD_DEBUG_LOGS=false

# Optional: テスト中だけ指定すると、そのサーバーにだけスラッシュコマンドを登録します。
# 未設定の場合はグローバルコマンドとして登録します。
# DISCORD_GUILD_ID=123456789012345678

# Optional: DISBOARD bumpリマインド用です。
# 未設定の場合は公開DISBOARD Bot IDを使います。
# DISBOARD_BOT_ID=302050872383242240

# Optional: ローカルのkeep-alive確認用です。
# Renderなどのホスティング環境ではPORTが自動で渡されるため、通常は設定不要です。
# KEEP_ALIVE_PORT=3000

# Optional: /setting set participant_role
# 参加者ロールIDです。
# PB_PARTICIPANT_ROLE_ID=123456789012345678

# Optional: /setting set parent_channel
# PB親VCのチャンネルIDです。
# PB_PARENT_CHANNEL_ID=123456789012345678

# Optional: /setting set child_category
# PBが子VCを作るカテゴリIDです。
# PB_CHILD_CATEGORY_ID=123456789012345678

# Optional: /setting set waiting_vc_category
# 途中参加用の待機VCを作成するカテゴリIDです。
# PB_WAITING_VC_CATEGORY_ID=123456789012345678

# Optional: /setting set waiting_vc_name
# 自動作成する待機VC名です。
# PB_WAITING_VC_NAME=途中参加部屋

# Optional: /setting set bosyu_mention_role
# ボタン募集で「@通話へのメンション」を有効にしたときの募集通知ロールIDです。
# PB_BOSYU_MENTION_ROLE_ID=123456789012345678

# Optional: /setting set voice_participant_role
# VCリマインダー対象者へ付与するロールIDです。
# PB_VOICE_PARTICIPANT_ROLE_ID=123456789012345678

# Optional: /setting set voice_reminder_enabled
# VCリマインダー機能の有効・無効です。
# PB_VOICE_REMINDER_ENABLED=true

# Optional: /setting set voice_reminder_channel
# VCリマインダー送信先テキストチャンネルIDです。
# PB_VOICE_REMINDER_CHANNEL_ID=123456789012345678

# Optional: /setting set voice_topic_channel
# 古い話題転送設定との互換用です。現在のリマインダー話題フォームでは使いません。
# PB_VOICE_TOPIC_CHANNEL_ID=123456789012345678

# Optional: /setting set voice_reminder_parent_channel
# VCリマインダー対象にするPB親VCのチャンネルIDです。
# PB_VOICE_REMINDER_PARENT_CHANNEL_ID=123456789012345678
# PB_VOICE_REMINDER_PARENT_CHANNEL_IDS=123456789012345678,234567890123456789

# Optional: /setting set voice_reminder_child_category
# VCリマインダー対象にするPB子VCカテゴリIDです。
# PB_VOICE_REMINDER_CHILD_CATEGORY_ID=123456789012345678

# Optional: /setting kokuchi announcement_channel
# /kokuchi の告知送信先、告知時刻から算出する事前案内送信先、/splitvc後のスタート案内送信先として使うテキストチャンネルIDです。
# PB_WADAI_CHANNEL_ID=123456789012345678

# Optional: /setting set post_split_wadai_channel
# /splitvc後の最初の話題と発話順を送るテキストチャンネルIDです。
# PB_POST_SPLIT_WADAI_CHANNEL_ID=123456789012345678

# Optional: /setting set split_start_channel
# 旧互換用です。現在は PB_WADAI_CHANNEL_ID と同じ送信先として扱います。
# PB_SPLIT_START_CHANNEL_ID=123456789012345678

# Optional: /setting set gathering_voice_channel
# /kokuchi の告知時刻から算出した集合時刻に閲覧・接続権限を一時開放し、/splitvc転送完了時に元へ戻す集合VCのIDです。
# PB_GATHERING_VOICE_CHANNEL_ID=123456789012345678

# Optional: /setting kokuchi mention_role
# /kokuchi の告知と集合リマインダーでメンションするロールIDをカンマ区切りで指定します。
# PB_KOKUCHI_MENTION_ROLE_IDS=123456789012345678,234567890123456789

# Optional: /setting set split_feedback_channel
# /splitvc終了後のお礼メッセージで意見・苦情案内として表示するチャンネルIDです。
# PB_SPLIT_FEEDBACK_CHANNEL_ID=1513457664041160765

# Optional: /setting set log_channel
# 運用ログをまとめるテキストチャンネルIDです。
# PB_LOG_CHANNEL_ID=123456789012345678

# Optional: /setting set form_channel
# フォームボタンを設置するテキストチャンネルIDです。
# PB_FORM_CHANNEL_ID=123456789012345678

# Optional: /setting set form_send_channel
# フォーム入力内容の転送先テキストチャンネルIDです。
# PB_FORM_SEND_CHANNEL_ID=123456789012345678

# Optional: /setting forms moderator_role
# 相談・苦情フォームでメンションするモデレーターロールIDです。
# PB_FORM_MODERATOR_ROLE_ID=123456789012345678

# Optional: /setting set finish_message
# 終了通知で送信する文面です。
# PB_FINISH_MESSAGE=30分が経過しました！各々のちょうどいいタイミングで解散してください

# Optional: /setting set transfer_wait_seconds
# 転送開始までの待機秒数です。0以上の整数を指定します。
# PB_TRANSFER_WAIT_SECONDS=30

# Optional: /setting set notice_wait_minutes
# 終了通知までの待機分数です。0以上の整数を指定します。
# PB_NOTICE_WAIT_MINUTES=25

# Optional: /setting set role_remove_wait_minutes
# 終了通知後の参加者ロール解除待機分数です。0以上の整数を指定します。
# PB_ROLE_REMOVE_WAIT_MINUTES=3

# Optional: /setting callwait call_wait_enabled
# 通話待機システムの有効・無効です。
# PB_CALL_WAIT_ENABLED=true

# Optional: /setting callwait call_wait_role
# 通話待機・ボタン募集で参加希望者に付与するロールIDです。
# PB_CALL_WAIT_ROLE_ID=123456789012345678

# Optional: /setting callwait call_wait_prompt_channel
# 定時募集メッセージを送るテキストチャンネルIDです。
# PB_CALL_WAIT_PROMPT_CHANNEL_ID=123456789012345678

# Optional: /setting callwait call_wait_notice_channel
# 常設パネル、匿名募集、成立通知、VC開始通知を送るテキストチャンネルIDです。
# PB_CALL_WAIT_NOTICE_CHANNEL_ID=123456789012345678

# Optional: /setting callwait call_wait_voice_category
# xx:00時点で2人以上いるか確認するVCカテゴリIDです。
# PB_CALL_WAIT_VOICE_CATEGORY_ID=123456789012345678

# Optional: /setting callwait call_wait_interval_minutes
# 30、45、60分から選べます。未設定時は30分です。
# PB_CALL_WAIT_INTERVAL_MINUTES=30

# Optional: /setting callwait otebo_quick_confirm_seconds
# ボタン募集で、参加希望後にキャンセルできる秒数です。
# PB_OTEBO_QUICK_CONFIRM_SECONDS=30

# Optional: 古い設定との互換用です。
# 新規設定ではPB_PARTICIPANT_ROLE_ID、PB_WAITING_VC_CATEGORY_IDを使ってください。
# PB_TEMP_ROLE_ID=123456789012345678
# PB_WAITING_CHANNEL_ID=123456789012345678
